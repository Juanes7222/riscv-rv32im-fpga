<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE signal_tap SYSTEM "signal_tap.dtd">

<!--
    SignalTap II configuration for single_cycle architecture.
    Trigger on program_done_synced == 1, capture cycle_count and instr_retired.

    Generated by scripts/create_stp.tcl - do not edit manually.
-->

<signal_tap>
 <tap_instance name="perf_capture_sc">
  <clock>
   <assignment name="clock_pin_name" value="clk"/>
  </clock>
  <signal_set name="signals">
   <assignment name="signal" value="top_single_cycle|u_perf|cycle_count[63..0]"/>
   <assignment name="signal" value="top_single_cycle|u_perf|instr_retired[63..0]"/>
   <assignment name="signal" value="top_single_cycle|u_perf|program_done_synced"/>
  </signal_set>
  <trigger_set name="trigger_0">
   <assignment name="trigger_mode" value="advanced"/>
   <assignment name="trigger_condition" value="top_single_cycle|u_perf|program_done_synced == 1"/>
  </trigger_set>
  <storage>
   <assignment name="sample_depth" value="1K"/>
   <assignment name="trigger_position" value="1"/>
   <assignment name="ram_type" value="auto"/>
  </storage>
 </tap_instance>
</signal_tap>
