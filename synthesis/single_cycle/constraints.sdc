# Timing constraints for rv32im on DE1-SoC (Cyclone V 5CSEMA5F31C6)
#
# Both microarchitectures use identical constraints to satisfy the
# homogeneous measurement protocol. Do not modify one without the other.
#
# Target: 100 MHz (10 ns period). This is intentionally aggressive so that
# Quartus reports the true achievable Fmax after place-and-route rather than
# stopping at an artificially relaxed target.

# Primary clock (board oscillator).  The single-cycle processor runs from a
# 25 MHz PLL output derived from this pin (ADR 049); the pipeline runs from the
# pin itself.  DE1-SoC provides the 50 MHz oscillator on PIN_AF14.
create_clock -period 10.000 -name clk [get_ports clk]

# VGA pixel clock (74.25 MHz generated by vga_pll from 50 MHz input)
# derive_pll_clocks auto-detects all PLL outputs regardless of the internal
# hierarchical path; wrap in a catch so the processor compiles without the
# visualization module (no PLL instantiated yet).  This also derives the
# 25 MHz single-cycle CPU clock, so its 20 ns period is analysed at the same
# 2x-aggressive ratio as the pin clock (40 ns on the board).
catch { derive_pll_clocks }

# Processor clock domains: the pin clock, plus the single-cycle CPU PLL when
# it exists (the pipeline has none; the pattern simply matches nothing there).
set proc_clocks [get_clocks -nowarn {clk *cpu_pll*divclk*}]

# Clock uncertainty
# Accounts for clock jitter on the Cyclone V device.
set_clock_uncertainty -rise_from $proc_clocks \
                      -rise_to   $proc_clocks 0.100
set_clock_uncertainty -fall_from $proc_clocks \
                      -fall_to   $proc_clocks 0.100
# The single-cycle data memory captures its read address on the falling edge,
# so a load crosses clock edges inside one cycle (ADR 048).  These transfers
# need the same uncertainty as the rising-edge one; the pipeline has no such
# path, so the constraint is inert there, but both files stay identical.
set_clock_uncertainty -rise_from $proc_clocks \
                      -fall_to   $proc_clocks 0.100
set_clock_uncertainty -fall_from $proc_clocks \
                      -rise_to   $proc_clocks 0.100

set vga_clk_name [get_clocks -nowarn *vga*pll*divclk*]
if {[llength $vga_clk_name] > 0} {
    set_clock_uncertainty -rise_from $vga_clk_name \
                          -rise_to   $vga_clk_name 0.150
    set_clock_uncertainty -fall_from $vga_clk_name \
                          -fall_to   $vga_clk_name 0.150

    # Asynchronous clock domain crossing - processor (50 MHz) and VGA (74.25 MHz)
    # operate in separate clock domains with no synchroniser.
    set_false_path -from $proc_clocks -to $vga_clk_name
    set_false_path -from $vga_clk_name -to $proc_clocks

    # The pixel-domain reset synchroniser samples the system reset
    # asynchronously, exactly like the other cross-domain signals.
    set_false_path -from [get_ports {rst_n}] -to $vga_clk_name
}

# Input and output delays
# Conservative estimates for FPGA-internal paths; adjust when interfacing
# with external components (switches, LEDs, HEX displays on DE1-SoC).
set_input_delay  -clock clk -max 2.000 [get_ports {rst_n}]
set_input_delay  -clock clk -min 0.500 [get_ports {rst_n}]

# False paths
# Asynchronous inputs that do not require timing analysis.
# set_false_path -from [get_ports {KEY[0]}]  ;# uncomment when reset is on KEY
