# Run once with: quartus_sh -t setup.tcl
# After running, use build.tcl for all subsequent compilations.

load_package flow

# Project configuration
set project_name    "rv32im_pipeline"
set device          "5CSEMA5F31C6"
set family          "Cyclone V"
set top_level       "top_pipeline"

# Paths relative to this script's location (synthesis/pipeline/)
set rtl_shared      "../../rtl/shared"
set rtl_arch        "../../rtl/pipeline"
set constraints_sdc "constraints.sdc"
set pinout          "../de1soc_pins.tcl"

# Guard: abort if project already exists
if {[file exists "$project_name.qpf"]} {
    puts "Project $project_name already exists. Delete .qpf and .qsf to re-run setup."
    exit 0
}

# Create project
project_new $project_name

set_global_assignment -name FAMILY           $family
set_global_assignment -name DEVICE           $device
set_global_assignment -name TOP_LEVEL_ENTITY $top_level

# Add RTL source files
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# Glob picks up all .sv files so new modules are included automatically.
foreach sv_file [glob -nocomplain "$rtl_shared/*.sv"] {
    set_global_assignment -name SYSTEMVERILOG_FILE $sv_file
}

foreach sv_file [glob -nocomplain "$rtl_arch/*.sv"] {
    set_global_assignment -name SYSTEMVERILOG_FILE $sv_file
}

# Timing constraints
set_global_assignment -name SDC_FILE $constraints_sdc

# Memory depths: small values for fast Quartus compilation.
# They must match the image generation depths in the Makefile
# (IMEM_DEPTH / DMEM_DEPTH).  The console's shadow copies of the program
# and data memories are sized from these parameters, so the resource budget
# of the whole design depends on them.
set_parameter -name IMEM_DEPTH 2048
set_parameter -name DMEM_DEPTH 512

# Video memory initialisation and font ROM hex
set_global_assignment -name MIF_FILE screen.mif
set_global_assignment -name HEX_FILE ../../rtl/shared/vga_font_rom.hex

# Pin assignments, I/O standards and memory sizes.
# The .qsf is generated by Quartus and is not versioned, so the pinout is
# kept in a versioned file that both architectures share.
source $pinout

# Synthesis settings
# Identical in both architectures to satisfy the homogeneous protocol
# requirement.  Do not change these settings independently.
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name OPTIMIZATION_MODE        "Balanced"
set_global_assignment -name DSP_BLOCK_BALANCING      "Auto"
set_global_assignment -name AUTO_RAM_RECOGNITION     "On"
set_global_assignment -name OPTIMIZE_POWER_DURING_SYNTHESIS "Off"

# Seed of the fitter.  The replicas override it with their own number
# (make replicas); this is the seed of the reference build.
set_global_assignment -name SEED 5

project_close

puts ""
puts "Setup complete: $project_name"
puts "Run 'quartus_sh -t build.tcl' to synthesize."
